        ToggleBindBtn.BackgroundColor3 = BindEnabled and Color3.fromRGB(50,200,50) or Color3.fromRGB(200,50,50)
        ToggleBindBtn.Text = BindEnabled and "ON" or "OFF"
        ToggleBindBtn.TextColor3 = CurrentTheme.BtnText
        ToggleBindBtn.Font = Enum.Font.GothamBold
        ToggleBindBtn.TextSize = 12
        ToggleBindBtn.AutoButtonColor = false
        local bindCorner = Instance.new("UICorner", ToggleBindBtn)
        bindCorner.CornerRadius = UDim.new(0, 6)

        local BindBtn = Instance.new("TextButton", Row)
        BindBtn.Name = "ActionBtn"
        BindBtn.Size = UDim2.new(0, 48, 0, 26)
        BindBtn.Position = UDim2.new(0.76, 0, 0.5, -13)
        BindBtn.BackgroundColor3 = CurrentTheme.Accent
        BindBtn.Text = CurrentKey.Name
        BindBtn.TextColor3 = CurrentTheme.BtnText
        BindBtn.Font = Enum.Font.GothamBold
        BindBtn.TextSize = 13
        local btnCorner = Instance.new("UICorner", BindBtn)
        btnCorner.CornerRadius = UDim.new(0, 6)

        local function SetToggle(state)
            Toggled = state
            local targetColor = Toggled and Color3.fromRGB(50,200,50) or Color3.fromRGB(70,70,80)
            local dotPos = Toggled and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
            TweenService:Create(ToggleBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {BackgroundColor3 = targetColor}):Play()
            TweenService:Create(Dot, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Position = dotPos}):Play()
            if callback then callback(Toggled) end
        end

        local function SetBindEnabled(state)
            BindEnabled = state
            ToggleBindBtn.BackgroundColor3 = BindEnabled and Color3.fromRGB(50,200,50) or Color3.fromRGB(200,50,50)
            ToggleBindBtn.Text = BindEnabled and "ON" or "OFF"
        end

        local toggleClick = ToggleBtn.MouseButton1Click:Connect(function() SetToggle(not Toggled) end)
        table.insert(Connections, toggleClick)
        table.insert(Library.Connections, toggleClick)

        local toggleBindClick = ToggleBindBtn.MouseButton1Click:Connect(function() SetBindEnabled(not BindEnabled) end)
        table.insert(Connections, toggleBindClick)
        table.insert(Library.Connections, toggleBindClick)

        local bindClick = BindBtn.MouseButton1Click:Connect(function()
            Binding = true
            BindBtn.Text = "..."
            BindBtn.BackgroundColor3 = Color3.fromRGB(255,100,100)
            local conn
            conn = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    Binding = false
                    CurrentKey = input.KeyCode
                    BindBtn.Text = CurrentKey.Name
                    BindBtn.BackgroundColor3 = CurrentTheme.Accent
                    if conn then conn:Disconnect() end
                end
            end)
            table.insert(Connections, conn)
            table.insert(Library.Connections, conn)
            task.wait(5)
            if Binding then
                Binding = false
                BindBtn.Text = CurrentKey.Name
                BindBtn.BackgroundColor3 = CurrentTheme.Accent
                if conn then conn:Disconnect() end
            end
        end)
        table.insert(Connections, bindClick)
        table.insert(Library.Connections, bindClick)

        local bindGlobal = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if Binding then return end
            if not BindEnabled then return end
            if UserInputService:GetFocusedTextBox() then return end
            if input.KeyCode == CurrentKey then SetToggle(not Toggled) end
        end)
        table.insert(Connections, bindGlobal)
        table.insert(Library.Connections, bindGlobal)

        local ancestryConn = Row.AncestryChanged:Connect(function()
            if not Row.Parent then
                for _, c in ipairs(Connections) do if c and c.Disconnect then c:Disconnect() end end
            end
        end)
        table.insert(Connections, ancestryConn)
        table.insert(Library.Connections, ancestryConn)
    end

    function TabBase:AddButtonRow(text, btnText, callback)
        self.Count = self.Count + 1
        local Row = Instance.new("Frame", self.Page)
        Row.Name = "Row"
        Row.Size = UDim2.new(1, -10, 0, 56)
        Row.BackgroundColor3 = CurrentTheme.Secondary
        Row.LayoutOrder = self.Count
        local rowCorner = Instance.new("UICorner", Row)
        rowCorner.CornerRadius = UDim.new(0, 10)
        local rowStroke = Instance.new("UIStroke", Row)
        rowStroke.Thickness = 1
        rowStroke.Color = CurrentTheme.Stroke
        rowStroke.Transparency = 0.4

        local L = Instance.new("TextLabel", Row)
        L.Size = UDim2.new(0.6, 0, 1, 0)
        L.Position = UDim2.new(0, 12, 0, 0)
        L.Text = text
        L.TextColor3 = CurrentTheme.Text
        L.Font = Enum.Font.GothamMedium
        L.TextSize = 15
        L.BackgroundTransparency = 1
        L.TextXAlignment = Enum.TextXAlignment.Left

        local B = Instance.new("TextButton", Row)
        B.Name = "ActionBtn"
        B.Size = UDim2.new(0.3, 0, 0, 32)
        B.Position = UDim2.new(0.65, 0, 0.5, -16)
        B.BackgroundColor3 = CurrentTheme.Accent
        B.Text = btnText
        B.TextColor3 = CurrentTheme.BtnText
        B.Font = Enum.Font.GothamBold
        B.TextSize = 15
        local btnCorner = Instance.new("UICorner", B)
        btnCorner.CornerRadius = UDim.new(0, 6)

        local enter = B.MouseEnter:Connect(function() TweenService:Create(B, TweenInfo.new(0.15), {BackgroundColor3 = CurrentTheme.Accent:Lerp(Color3.new(1,1,1), 0.15)}):Play() end)
        table.insert(Library.Connections, enter)
        local leave = B.MouseLeave:Connect(function() TweenService:Create(B, TweenInfo.new(0.15), {BackgroundColor3 = CurrentTheme.Accent}):Play() end)
        table.insert(Library.Connections, leave)
        local click = B.MouseButton1Click:Connect(function()
            if callback then callback() end
            TweenService:Create(B, TweenInfo.new(0.1), {Size = UDim2.new(0.28, 0, 0, 30)}):Play()
            task.wait(0.1)
            TweenService:Create(B, TweenInfo.new(0.1), {Size = UDim2.new(0.3, 0, 0, 32)}):Play()
        end)
        table.insert(Library.Connections, click)
    end

    function TabBase:AddToggleButton(text, default, callback)
        self.Count = self.Count + 1
        local Toggled = default or false

        local Row = Instance.new("Frame", self.Page)
        Row.Name = "Row"
        Row.Size = UDim2.new(1, -10, 0, 56)
        Row.BackgroundColor3 = CurrentTheme.Secondary
        Row.LayoutOrder = self.Count
        local rowCorner = Instance.new("UICorner", Row)
        rowCorner.CornerRadius = UDim.new(0, 10)
        local rowStroke = Instance.new("UIStroke", Row)
        rowStroke.Thickness = 1
        rowStroke.Color = CurrentTheme.Stroke
        rowStroke.Transparency = 0.4

        local L = Instance.new("TextLabel", Row)
        L.Size = UDim2.new(0.6, 0, 1, 0)
        L.Position = UDim2.new(0, 12, 0, 0)
        L.Text = text
        L.TextColor3 = CurrentTheme.Text
        L.Font = Enum.Font.GothamMedium
        L.TextSize = 15
        L.BackgroundTransparency = 1
        L.TextXAlignment = Enum.TextXAlignment.Left

        local ToggleBtn = Instance.new("TextButton", Row)
        ToggleBtn.Name = "ToggleBtn"
        ToggleBtn.Size = UDim2.new(0, 48, 0, 28)
        ToggleBtn.Position = UDim2.new(0.65, 0, 0.5, -14)
        ToggleBtn.BackgroundColor3 = Toggled and Color3.fromRGB(50,200,50) or Color3.fromRGB(70,70,80)
        ToggleBtn.Text = ""
        ToggleBtn.AutoButtonColor = false
        local toggleCorner = Instance.new("UICorner", ToggleBtn)
        toggleCorner.CornerRadius = UDim.new(1,0)
        local toggleStroke = Instance.new("UIStroke", ToggleBtn)
        toggleStroke.Color = Color3.fromRGB(255,255,255)
        toggleStroke.Transparency = 0.6
        toggleStroke.Thickness = 1

        local Dot = Instance.new("Frame", ToggleBtn)
        Dot.Name = "Dot"
        Dot.Size = UDim2.new(0, 22, 0, 22)
        Dot.Position = Toggled and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
        Dot.BackgroundColor3 = Color3.fromRGB(255,255,255)
        Dot.BorderSizePixel = 0
        local dotCorner = Instance.new("UICorner", Dot)
        dotCorner.CornerRadius = UDim.new(1,0)

        local click = ToggleBtn.MouseButton1Click:Connect(function()
            Toggled = not Toggled
            local targetColor = Toggled and Color3.fromRGB(50,200,50) or Color3.fromRGB(70,70,80)
            local dotPos = Toggled and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 2, 0.5, -11)
            TweenService:Create(ToggleBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {BackgroundColor3 = targetColor}):Play()
            TweenService:Create(Dot, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Position = dotPos}):Play()
            if callback then callback(Toggled) end
        end)
        table.insert(Library.Connections, click)
    end

    function Library:CreateTab(name, isSettings)
        local NewTab = setmetatable({}, TabBase)
        NewTab.Count = 0

        local TabBtn = Instance.new("TextButton", SidebarScroll)
        TabBtn.Name = "TabBtn"
        TabBtn.Size = UDim2.new(0.95, 0, 0, 38)
        TabBtn.BackgroundColor3 = CurrentTheme.Secondary
        TabBtn.Text = name
        TabBtn.TextColor3 = CurrentTheme.Text
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextSize = 15
        local tabCorner = Instance.new("UICorner", TabBtn)
        tabCorner.CornerRadius = UDim.new(0, 8)
        local tabStroke = Instance.new("UIStroke", TabBtn)
        tabStroke.Thickness = 1
        tabStroke.Color = CurrentTheme.Stroke
        tabStroke.Transparency = 0.3
        table.insert(Library.TabButtons, TabBtn)

        local Page = Instance.new("ScrollingFrame", PagesFolder)
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.Visible = false
        Page.ScrollBarThickness = 0
        Page.CanvasSize = UDim2.new(0, 0, 0, 0)
        Page.Name = "Page_"..name

        local List = Instance.new("UIListLayout", Page)
        List.Padding = UDim.new(0, 10)
        List.SortOrder = Enum.SortOrder.LayoutOrder
        local listSizeConn = List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y + 20)
        end)
        table.insert(Library.Connections, listSizeConn)

        NewTab.Page = Page

        local tabClick = TabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(PagesFolder:GetChildren()) do p.Visible = false end
            for _, b in pairs(Library.TabButtons) do
                b:SetAttribute("Active", false)
                TweenService:Create(b, TweenInfo.new(0.3), {BackgroundColor3 = CurrentTheme.Secondary, TextColor3 = CurrentTheme.Text}):Play()
            end
            Page.Visible = true
            TabBtn:SetAttribute("Active", true)
            TweenService:Create(TabBtn, TweenInfo.new(0.3), {BackgroundColor3 = CurrentTheme.Accent, TextColor3 = CurrentTheme.BtnText}):Play()
        end)
        table.insert(Library.Connections, tabClick)

        if not isSettings and #Library.TabButtons == 1 then
            Page.Visible = true
            TabBtn:SetAttribute("Active", true)
            TabBtn.BackgroundColor3 = CurrentTheme.Accent
            TabBtn.TextColor3 = CurrentTheme.BtnText
        end
        return NewTab
    end

    local Settings = Library:CreateTab("⚙️ Themes", true)
    for name, data in pairs(Themes) do
        Settings:AddButtonRow(name, "Apply", function() ApplyTheme(data, name) end)
    end

    function Library:Destroy()
        for _, c in ipairs(Library.Connections) do if c and c.Disconnect then c:Disconnect() end end
        ScreenGui:Destroy()
    end

    return Library
end

return UI_Module
