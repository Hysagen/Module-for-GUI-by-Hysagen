    local function ApplyTheme(theme, themeName)
        CurrentTheme = theme
        local tInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart)
        for _, obj in pairs(ScreenGui:GetDescendants()) do
            if obj.Name == "MainFrame" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Main}):Play()
                local b = obj:FindFirstChildWhichIsA("UIStroke")
                if b and b.Thickness == 1.5 then TweenService:Create(b, tInfo, {Color = theme.Stroke, Transparency = 0.4}):Play() end
            elseif obj.Name == "Sidebar" or obj.Name == "TitleBar" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Sidebar}):Play()
                local s = obj:FindFirstChildWhichIsA("UIStroke")
                if s then TweenService:Create(s, tInfo, {Color = theme.Stroke}):Play() end
            elseif obj:IsA("UIStroke") and obj.Parent.Name ~= "SliderKnob" then
                TweenService:Create(obj, tInfo, {Color = theme.Stroke}):Play()
            elseif obj.Name == "Row" or obj.Name == "SliderBack" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Secondary}):Play()
            elseif obj.Name == "ActionBtn" or obj.Name == "SliderFill" or obj.Name == "SliderKnob" then
                TweenService:Create(obj, tInfo, {BackgroundColor3 = theme.Accent}):Play()
                if obj:IsA("TextButton") then TweenService:Create(obj, tInfo, {TextColor3 = theme.BtnText}):Play() end
            elseif obj:IsA("TextLabel") and obj.Parent.Name ~= "SliderKnob" and obj.Name ~= "MinimizeBtn" and obj.Name ~= "CloseBtn" then
                TweenService:Create(obj, tInfo, {TextColor3 = theme.Text}):Play()
            end
        end
        for _, btn in pairs(Library.TabButtons) do
            if btn:GetAttribute("Active") then TweenService:Create(btn, tInfo, {BackgroundColor3 = theme.Accent, TextColor3 = theme.BtnText}):Play()
            else TweenService:Create(btn, tInfo, {BackgroundColor3 = theme.Secondary, TextColor3 = theme.Text}):Play() end
        end
        if themeName then saveTheme(themeName) end
    end

