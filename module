        local ListFrame = Instance.new("Frame", container)
        ListFrame.Size = UDim2.new(1, 0, 0, 0)
        ListFrame.Position = UDim2.new(0, 0, 0, 44)
        ListFrame.BackgroundColor3 = CurrentTheme.Main
        ListFrame.ClipsDescendants = true
        ListFrame.BorderSizePixel = 0
        local listFrameCorner = Instance.new("UICorner", ListFrame)
        listFrameCorner.CornerRadius = UDim.new(0, 8)

        local Scroll = Instance.new("ScrollingFrame", ListFrame)
        Scroll.Size = UDim2.new(1, -4, 1, -4)
        Scroll.Position = UDim2.new(0, 2, 0, 2)
        Scroll.BackgroundTransparency = 1
        Scroll.BorderSizePixel = 0
        Scroll.ScrollBarThickness = 3
        Scroll.ScrollBarImageColor3 = CurrentTheme.Accent

        local ListLayout = Instance.new("UIListLayout", Scroll)
        ListLayout.Padding = UDim.new(0, 2)
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local selectedCount = 0
        local states = {}

        local function updateHeader()
            MainBtn.Text = "  " .. text .. " (" .. selectedCount .. ")"
        end

        for _, itemName in ipairs(items) do
            local state = defaultState
            states[itemName] = state
            if state then selectedCount = selectedCount + 1 end

            local ItemBtn = Instance.new("TextButton", Scroll)
            ItemBtn.Size = UDim2.new(1, 0, 0, 28)
            ItemBtn.BackgroundColor3 = state and CurrentTheme.Accent or CurrentTheme.Secondary
            ItemBtn.Text = "   " .. itemName
            ItemBtn.TextColor3 = state and CurrentTheme.BtnText or CurrentTheme.Text
            ItemBtn.Font = Enum.Font.Gotham
            ItemBtn.TextSize = 13
            ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
            ItemBtn.AutoButtonColor = false
            local corner = Instance.new("UICorner", ItemBtn)
            corner.CornerRadius = UDim.new(0, 4)

            ItemBtn.MouseButton1Click:Connect(function()
                states[itemName] = not states[itemName]
                if states[itemName] then
                    selectedCount = selectedCount + 1
                    ItemBtn.BackgroundColor3 = CurrentTheme.Accent
                    ItemBtn.TextColor3 = CurrentTheme.BtnText
                else
                    selectedCount = selectedCount - 1
                    ItemBtn.BackgroundColor3 = CurrentTheme.Secondary
                    ItemBtn.TextColor3 = CurrentTheme.Text
                end
                updateHeader()
                if callback then callback(itemName, states[itemName]) end
            end)
        end

        updateHeader()

        local isOpen = false
        local maxHeight = math.min(#items * 30 + 4, 180)

        local function updatePageCanvas()
            if self.Page then
                local list = self.Page:FindFirstChildOfClass("UIListLayout")
                if list then self.Page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 20) end
            end
        end

        MainBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            Arrow.Text = isOpen and "▲" or "▼"
            local targetHeight = isOpen and maxHeight or 0
            TweenService:Create(ListFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            TweenService:Create(container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 44 + targetHeight)}):Play()
            Scroll.CanvasSize = UDim2.new(0, 0, 0, #items * 30)
            task.wait(0.2)
            updatePageCanvas()
        end)
    end

