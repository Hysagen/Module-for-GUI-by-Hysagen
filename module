_G.IsDraggingSlider = false
local THEME_FILE = "hysagen_ui_theme.txt"

local function loadSavedTheme()
    local success, result = pcall(function() return HttpService:JSONDecode(readfile(THEME_FILE)) end)
    if success and result and result.theme then return result.theme end
    return nil
end

local function saveTheme(themeName)
    local settings = { theme = themeName, savedAt = DateTime.now():ToIsoDate() }
    pcall(function() writefile(THEME_FILE, HttpService:JSONEncode(settings)) end)
end

local function MakeDraggable(gui)
    local dragging = false
    local dragStart, startPos
    local function update(input)
        if not dragging or not dragStart or not startPos then return end
        local delta = input.Position - dragStart
        gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
    local began = gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not _G.IsDraggingSlider then
            dragging = true; dragStart = input.Position; startPos = gui.Position
        end
    end)
    local ended = gui.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    local changed = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging and not _G.IsDraggingSlider then update(input) end
    end)
    return { began, ended, changed }
end

